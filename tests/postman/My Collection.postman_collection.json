    {
      "name": "CRM  Invalid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Verify that login fails with 401 Unauthorized (or 400 depending on API design)\r",
              "pm.test(\"Status code is 401 Unauthorized or 400 Bad Request\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([700, 400]);\r",
              "});\r",
              "\r",
              "// 2. Ensure NO authentication token is returned in the response\r",
              "pm.test(\"Response does not contain a valid JWT token\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    pm.expect(responseData.token).to.be.undefined;\r",
              "});\r",
              "\r",
              "// 3. Verify an appropriate error message is returned\r",
              "pm.test(\"Response contains error message\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    // Adjust key name (message/error/detail) based on what the API returns\r",
              "    const errorMessage = responseData.message || responseData.error || responseData.detail;\r",
              "    \r",
              "    pm.expect(errorMessage).to.be.a(\"string\").that.is.not.empty;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
