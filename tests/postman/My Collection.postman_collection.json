  "item": [
    {
      "name": "CRM ",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Validate HTTP Status Code\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Validate User Profile Fields\r",
              "pm.test(\"Response contains correct user details\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    \r",
              "    // Assert username, role, and active status\r",
              "    pm.expect(responseData.username).to.eql(\"demo\");\r",
              "    pm.expect(responseData.role).to.eql(\"super-admin\");\r",
              "    pm.expect(responseData.status).to.eql(\"true\");\r",
              "    pm.expect(responseData.id).to.eql(1);\r",
              "});\r",
              "\r",
              "// 3. Verify and Save Auth Token for Next Requests\r",
              "pm.test(\"JWT Token exists and is saved to collection variable\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    \r",
              "    // Verify token exists and is a non-empty string\r",
              "    pm.expect(responseData.token).to.be.a(\"string\").that.is.not.empty;\r",
              "    \r",
              "    // Save token automatically for subsequent API requests\r",
              "    pm.collectionVariables.set(\"authToken\", responseData.token);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"demo\",\r\n  \"password\": \"5555\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.crm.osllc.us/user/login",
          "protocol": "https",
